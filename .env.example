# Smart Gateway Configuration
PORT=3000
ADMIN_PASSWORD=admin123
DB_PATH=data/smart-gateway.db

# 路由策略: race(竞速上岗) / weighted(加权随机) / lowest_latency(最低延迟) / round_robin(轮询)
AUTO_STRATEGY=race

# 健康检测间隔(秒)
HEALTH_INTERVAL=60

# 竞速引擎配置
RACE_INTERVAL=60
RACE_TEST_PROMPT=Say hi in one word
RACE_TEST_MAX_TOKENS=5
RACE_TEST_TIMEOUT=30

# 失败屏蔽
FAIL_BAN_COUNT=3
FAIL_BAN_DURATION=300
REQUEST_TIMEOUT=120
